ARG SPARK_IMAGE=apache/spark:4.1.3-scala2.13-java21-python3-ubuntu
FROM ${SPARK_IMAGE} AS spark-runtime
FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends openjdk-17-jre-headless procps \
    && rm -rf /var/lib/apt/lists/* && useradd --uid 185 --no-create-home spark
COPY --from=spark-runtime /opt/spark /opt/spark
ARG ICEBERG_VERSION=1.12.0
ARG MAVEN=https://repo1.maven.org/maven2
ADD ${MAVEN}/org/apache/iceberg/iceberg-spark-runtime-4.1_2.13/${ICEBERG_VERSION}/iceberg-spark-runtime-4.1_2.13-${ICEBERG_VERSION}.jar /opt/spark/jars/
ADD ${MAVEN}/org/apache/iceberg/iceberg-azure-bundle/${ICEBERG_VERSION}/iceberg-azure-bundle-${ICEBERG_VERSION}.jar /opt/spark/jars/
RUN chmod 0644 /opt/spark/jars/*.jar
WORKDIR /opt/research
COPY pyproject.toml ./
COPY src ./src
RUN python3 -m pip install --no-cache-dir .
COPY docker/run_worker.py docker/smoke_iceberg.py ./
ARG CODE_VERSION=local
ENV OPENINGS_CODE_VERSION=${CODE_VERSION} HOME=/tmp PYTHONDONTWRITEBYTECODE=1 \
    SPARK_HOME=/opt/spark PYSPARK_PYTHON=/usr/local/bin/python3
USER 185
ENTRYPOINT ["/opt/spark/bin/spark-submit", "--master", "local[2]", "--driver-memory", "2g", "/opt/research/run_worker.py"]
