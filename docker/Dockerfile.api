# Read-only explorer API: FastAPI over Iceberg via pyiceberg + DuckDB. Base pinned by
# digest (Dependabot bumps it); Python dependencies pinned in pyproject.toml.
FROM python:3.13-slim@sha256:57b29a7c050c4e679e4bea572e14b3965cf4b5839de2da49d55e49ffc4024f39
# OS security updates on top of the pinned base (CI fails on fixable critical CVEs).
RUN apt-get update && apt-get -y upgrade && rm -rf /var/lib/apt/lists/*
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/tmp
WORKDIR /app
COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir '.[api]'
USER 10001
EXPOSE 8000
CMD ["uvicorn", "openings_research.api:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]
